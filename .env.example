# LLM provider settings
# Supported providers: openai, openai-compatible, deepseek, kimi, tongyi, zhipu, ollama
ASEN_PROVIDER=openai
ASEN_API_KEY=sk-your-api-key
ASEN_BASE_URL=https://api.openai.com/v1
ASEN_MODEL=gpt-4o-mini

# Ollama example:
# ASEN_PROVIDER=ollama
# ASEN_BASE_URL=http://localhost:11434
# ASEN_MODEL=llama3.1

# Optional runtime settings
ASEN_WORKSPACE=.
ASEN_MAX_STEPS=8
ASEN_REQUIRE_APPROVAL=true
ASEN_COMMAND_TIMEOUT_SECONDS=20
